    "      \\node[stage={clrPurple50}{clrPurple800}, right=of chunk](embed) {\\textbf{Embedding}\\\\[1pt]{\\scriptsize Mistral Embed,\\\\per chunk}};\n",
    "      \\node[stage={clrPurple50}{clrPurple800}, right=of embed](index) {\\textbf{Vector index}\\\\[1pt]{\\scriptsize pgvector,\\\\cosine sim.}};\n",
    "\n",
    "      \\node[laneLabel] at ($(pdfs.west)+(-0.25,0)$) {Indexing\\\\{\\scriptsize\\itshape per firm-year}};\n",
    "\n",
