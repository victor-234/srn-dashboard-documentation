    "      },\n",
    "    ]\n",
    "\n",
    "      % ── Lane A: Indexing (one-time, per company) ──────────────────────────────\n",
    "      \\node[stage={clrGray50}{clrGray800}]                    (pdfs)  {\\textbf{Input}\\\\[1pt]{\\scriptsize Annual\\,+\\,sustainability\\\\report (PDF)}};\n",
