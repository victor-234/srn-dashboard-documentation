    "\n",
    "import json, textwrap\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "with open(\"performance_snapshot.json\") as f:\n",
    "    snap = json.load(f)\n",
    "\n",
    "rows = sorted(snap[\"by_field\"], key=lambda r: r.get(\"accuracy_pct\") or 0)\n",
    "\n",
    "def wrap(s, w=42):\n",
