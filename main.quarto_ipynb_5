    "      \\node[stage={clrPurple50}{clrPurple800}, right=of qgen]      (qemb)   {\\textbf{Query embed}\\\\[1pt]{\\scriptsize Mistral Embed}};\n",
    "      \\node[stage={clrTeal50}{clrTeal800},   right=of qemb]        (hybrid) {\\textbf{Hybrid retrieval}\\\\[1pt]{\\scriptsize vector\\,+\\,BM25\\\\RRF, top $k{=}5$}};\n",
    "      \\node[stage={clrAmber50}{clrAmber800}, right=of hybrid]      (llm)    {\\textbf{Extraction}\\\\[1pt]{\\scriptsize Mistral Large,\\\\Zod schema}};\n",
    "      \\node[stage={clrTeal50}{clrTeal800},   right=of llm]         (db)     {\\textbf{Record}\\\\[1pt]{\\scriptsize value, source page,\\\\confidence}};\n",
    "\n",
    "      \\node[laneLabel] at ($(field.west)+(-0.25,0)$) {Extraction\\\\{\\scriptsize\\itshape per indicator}};\n",
    "\n",
