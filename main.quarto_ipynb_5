    "#| echo: false\n",
    "#| output: asis\n",
    "import json, pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# Indicator schema: prefer the richer local CSV (carries the ESRS reference\n",
    "# code), fall back to the public release JSON.\n",
    "csv_path = Path(\"schema_fields_rows.csv\")\n",
    "if csv_path.exists():\n",
    "    df = (\n",
    "        pd.read_csv(csv_path)\n",
    "          .query(\"is_active == True\")\n",
    "          .sort_values([\"category\", \"display_order\"])\n",
    "          .reset_index(drop=True)\n",
    "    )\n",
    "    show_ref = True\n",
    "else:\n",
    "    fields = json.loads(Path(\"release_v1_2.json\").read_text())[\"fields\"]\n",
    "    df = (\n",
    "        pd.DataFrame(fields)\n",
    "          .sort_values([\"category\", \"display_order\"])\n",
    "          .reset_index(drop=True)\n",
    "    )\n",
    "    df[\"reference\"] = \"\"  # not exposed in the public release feed\n",
    "    show_ref = False\n",
    "\n",
    "category_meta = {\n",
    "    \"environmental\": \"Environmental\",\n",
    "    \"social\":        \"Social\",\n",
    "    \"governance\":    \"Governance\",\n",
    "}\n",
    "\n",
    "def esc(s):\n",
    "    if s is None or (isinstance(s, float) and pd.isna(s)):\n",
    "        return \"\"\n",
    "    repl = {\"&\": r\"\\&\", \"%\": r\"\\%\", \"$\": r\"\\$\", \"#\": r\"\\#\",\n",
    "            \"_\": r\"\\_\", \"{\": r\"\\{\", \"}\": r\"\\}\",\n",
    "            \"~\": r\"\\textasciitilde{}\", \"^\": r\"\\textasciicircum{}\"}\n",
    "    return \"\".join(repl.get(c, c) for c in str(s))\n",
    "\n",
    "tabular_spec = \"@{}l l l@{}\" if show_ref else \"@{}l l@{}\"\n",
    "ncols        = 3 if show_ref else 2\n",
    "header       = (r\"\\textbf{Ref.} & \\textbf{Indicator} & \\textbf{Unit} \\\\\"\n",
    "                if show_ref else\n",
    "                r\"\\textbf{Indicator} & \\textbf{Unit} \\\\\")\n",
    "\n",
    "out = [\n",
    "    r\"\\begin{table}[h]\",\n",
    "    r\"\\centering\\footnotesize\",\n",
    "    r\"\\setlength{\\tabcolsep}{6pt}\",\n",
    "    r\"\\renewcommand{\\arraystretch}{1.05}\",\n",
    "    rf\"\\begin{{tabular}}{{{tabular_spec}}}\",\n",
    "    r\"\\toprule\",\n",
    "    header,\n",
    "    r\"\\midrule\",\n",
    "]\n",
    "\n",
    "for i, cat in enumerate([\"environmental\", \"social\", \"governance\"]):\n",
    "    if i > 0:\n",
    "        out.append(r\"\\addlinespace[2pt]\\midrule\")\n",
    "    out.append(rf\"\\multicolumn{{{ncols}}}{{@{{}}l}}{{\\textit{{{category_meta[cat]}}}}} \\\\\")\n",
    "    out.append(r\"\\addlinespace[2pt]\")\n",
    "    for _, row in df[df[\"category\"] == cat].iterrows():\n",
    "        name = esc(row[\"name\"]).capitalize()\n",
    "        unit = esc(row[\"unit\"]) if pd.notna(row[\"unit\"]) and str(row[\"unit\"]).strip() else \"—\"\n",
    "        if show_ref:\n",
    "            ref = esc(row[\"reference\"])\n",
    "            out.append(rf\"{ref} & {name} & {unit} \\\\\")\n",
    "        else:\n",
    "            out.append(rf\"{name} & {unit} \\\\\")\n",
    "\n",
    "out += [\n",
    "    r\"\\bottomrule\",\n",
    "    r\"\\end{tabular}\",\n",
    "    r\"\\caption{ESG indicators extracted by the pipeline.}\",\n",
    "    r\"\\label{tab:indicators}\",\n",
    "    r\"\\end{table}\",\n",
    "]\n",
    "\n",
    "print(\"\\n\".join(out))"
