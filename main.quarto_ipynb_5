    "      \\draw[arr] (llm)    -- (db);\n",
    "\n",
    "      % index supplies the retrieval step\n",
    "      \\draw[arr] (index.south) -- ++(0,-0.55) -| (hybrid.north);\n",
    "\n",
    "      % reformulation loop: extraction → query generation (routed above the lane)\n",
    "      \\draw[arrDash, color=clrPurple600]\n",
    "        (llm.north) -- ++(0,0.55) -| (qgen.north);\n",
    "      \\node[font=\\scriptsize\\sffamily, text=clrPurple600] at\n",
    "        ($(qgen.north)!0.5!(llm.north)+(0,0.75)$)\n",
    "        {reformulate query ($\\leq 3$ retries)};\n",
    "\n",
    "      % dashed container around the extraction lane (per-indicator loop)\n",
    "      \\begin{scope}[on background layer]\n",
    "        \\node[dottedBox,\n",
